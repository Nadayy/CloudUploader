msgid "Could not connect to the upload server."
msgstr "No se pudo conectar con el servidor de subida."

msgid ""
"Could not connect to the upload server. Please check your internet "
"connection."
msgstr ""
"No se pudo conectar con el servidor de subida. Verifica tu conexión a "
"internet."

msgid ""
"The connection was lost while uploading. Please check your internet "
"connection and try again."
msgstr ""
"Se perdió la conexión durante la subida. Verifica tu conexión a internet e "
"inténtalo de nuevo."

msgid "The upload server returned an error ({status}): {text}"
msgstr "El servidor de subida devolvió un error ({status}): {text}"

